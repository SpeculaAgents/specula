# ---- engine (engine/src/config.ts reads these) ----
SPECULA_PORT=4100
SPECULA_PUBLIC_URL=https://speculaagents.fun/api
# Data chain. Comma-separated: the first is used, the rest are fallbacks. The public node works with no key.
SPECULA_RPC_URL=https://rpc.mainnet.chain.robinhood.com
SPECULA_DB=/data/specula.sqlite
SPECULA_DATA_DIR=/data
# How far back the index starts on a new database, in blocks (about 10 blocks a second).
SPECULA_BACKFILL_BLOCKS=200000

# The key every answer is signed with. Generate once, keep it secret, never change it lightly: agents pin its address.
SPECULA_ENGINE_KEY=

# Payments. Off until every line below is set. With payments off every answer is free.
SPECULA_PAYMENTS=off
SPECULA_PAY_TO=                # the wallet that receives what agents pay
SPECULA_RELAYER_KEY=           # a wallet with a little gas; it only submits payments agents signed
SPECULA_FREE_DAILY=100
SPECULA_FREE_DAILY_ANON=25
# Gas the relayer may spend per day (gas units), in all and per paying wallet. Counted in the database.
SPECULA_GAS_DAILY=200000000
SPECULA_GAS_DAILY_PER_ACCOUNT=10000000
# Proxies in front of the engine that append to X-Forwarded-For (the site is one). 0 ignores the header.
SPECULA_TRUST_PROXY=1

# Summaries and answers. "standin" is the built-in rule model and costs nothing.
SPECULA_AI=standin
ANTHROPIC_API_KEY=
SPECULA_AI_MODEL=

# The SEC asks automated clients to say who they are. Keep this descriptive.
SEC_USER_AGENT=Specula data engine (contact via speculaagents.fun)
SEC_MIN_GAP_MS=500

# Set after the contracts are deployed (not part of the first launch).
SPECULA_ANCHOR=
SPECULA_ORACLE=
SPECULA_TOKEN=
SPECULA_BOUNTIES=
SPECULA_ARCHIVE_DAYS=14
LOG_FORMAT=json

# ---- site (web) ----
SPECULA_ENGINE_URL=http://engine.railway.internal:4100
