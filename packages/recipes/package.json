{
  "name": "@specula/recipes",
  "version": "0.1.0",
  "private": true,
  "description": "Three small agents built on Specula. Each is one file you can read in a minute and run.",
  "type": "module",
  "scripts": {
    "launch-watcher": "tsx launch-watcher.ts",
    "filing-reader": "tsx filing-reader.ts",
    "morning-desk": "tsx morning-desk.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": { "@specula/sdk": "^0.1.0", "viem": "2.58.4" },
  "devDependencies": { "@types/node": "^24.0.0", "tsx": "4.23.15", "typescript": "^5.9.0" }
}
