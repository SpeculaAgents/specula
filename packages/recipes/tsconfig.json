{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "lib": [
      "ES2023",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@specula/sdk": [
        "../sdk/src/index.ts"
      ]
    }
  },
  "include": [
    "*.ts",
    "test"
  ]
}